# Database Connection (PostgreSQL 16+)
# For local Docker Compose: postgresql+psycopg://wonderland:wonderland_dev_password@localhost:5432/wonderland
DATABASE_URL=postgresql+psycopg://wonderland:wonderland_dev_password@localhost:5432/wonderland

# API Configuration
PORT=8000
API_HOST=127.0.0.1
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
